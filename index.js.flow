/**
 * https://github.com/atmulyana/reactjs-common
 * 
 * @flow
 */
import * as React from 'react';

export type Ref<T> = React.RefSetter<T>;
export type RefCallback<T> = Exclude< Ref<T>, React.RefObject<T> >;

declare export function setRef<Instance>(
    refProp: Ref<Instance>,
    ref: Instance | null
): void;

declare export var extRefCallback:
    (
        <T: ?{...}, P: ?{...}>(
            refProp: Ref<{...$Exact<T>, ...$Exact<P>}>,
            extRef: P | (T => P),
            callback?: ({...$Exact<T>, ...$Exact<P>}) => any,
        ) => RefCallback<T>
    ) & (
        <T, P>(
            refProp: Ref<T & P>,
            extRef: P | (T => P),
            callback?: (T & P) => any,
        ) => RefCallback<T>
    );

declare export function forwardRef<T, P: {...} = {}>(
    render: {
        (
            props: P,
            ref: Ref<T>
        ): React.Node;
        displayName?: string | void;
        propTypes?: any;
    }
): component(ref?: Ref<T>, ...P) & {
    displayName?: string | void;
    propTypes?: any;
};